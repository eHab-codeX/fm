_grid_view() {
  local dir="$1"
  local mark_i idx now last_idx=-1 last_t=0 f n
  GRID_PICK=""
  _in_kitty || {
    _pause "Gallery grid needs Kitty (kitten icat)."
    return 1
  }

  _probe_cell
  trap 'G_RESIZE=1' WINCH
  _grid_enter

  local leave=0
  while true; do
    dir=$(readlink -f -- "$dir") || break
    _g_load "$dir"
    G_RESIZE=0
    _g_layout
    _g_ensure_visible
    _g_redraw

    while true; do
      _g_readkey
      if ((G_RESIZE)); then
        G_RESIZE=0
        unset FM_CELL_W FM_CELL_H
        _probe_cell
        G_THUMB=()
        _g_relayout
      fi
      case "$KEY" in
      q | esc | quit)
        leave=1
        break
        ;;
      backspace | - | rclick)
        local parent
        parent=$(dirname -- "$dir")
        if [[ "$parent" != "$dir" ]]; then
          G_FOCUS="${dir##*/}"
          dir="$parent"
          break
        fi
        _g_bar "$G_ROWS" "Already at filesystem root."
        ;;
      left | h) ((G_N)) && _g_select $((G_SEL - 1)) ;;
      right | l) ((G_N)) && _g_select $((G_SEL + 1)) ;;
      up | k) ((G_N)) && _g_select $((G_SEL - G_NCOLS)) ;;
      down | j) ((G_N)) && _g_select $((G_SEL + G_NCOLS)) ;;
      pgup) ((G_N)) && _g_select $((G_SEL - G_NCOLS * G_VIS)) ;;
      pgdn) ((G_N)) && _g_select $((G_SEL + G_NCOLS * G_VIS)) ;;
      home | g) ((G_N)) && _g_select 0 ;;
      end | G) ((G_N)) && _g_select $((G_N - 1)) ;;
      wheelup) ((G_N)) && _g_scroll -1 ;;
      wheeldown) ((G_N)) && _g_scroll 1 ;;
      enter)
        if ((G_N)); then
          if ((G_SEL < G_NDIRS)); then
            dir="${G_FILES[G_SEL]}"
            break
          fi
          _g_full "$G_SEL"
          _g_ensure_visible
          _g_redraw
        fi
        ;;
      space)
        if ((G_N)); then
          if [[ -n "${G_MARK[$G_SEL]:-}" ]]; then unset 'G_MARK[$G_SEL]'; else G_MARK[$G_SEL]=1; fi
          mark_i=$G_SEL
          _g_cell_text "$mark_i"
          _g_select $((G_SEL + 1))
          _g_status
        fi
        ;;
      'a')
        if ((G_N)); then
          local vfirst=$((G_TOP * G_NCOLS))
          local vlast=$((vfirst + G_VIS * G_NCOLS - 1))
          ((vlast >= G_N)) && vlast=$((G_N - 1))
          for ((idx = vfirst; idx <= vlast; idx++)); do
            G_MARK[$idx]=1
            _g_cell_text "$idx"
          done
          _g_status
        fi
        ;;
      'A')
        G_MARK=()
        _g_redraw
        ;;
      click)
        idx=$(_g_hit)
        if ((idx >= 0)); then
          # EPOCHREALTIME -> integer microseconds (the decimal separator
          # follows the locale, so strip either "." or ",").
          now=${EPOCHREALTIME/[.,]/}
          if ((idx == last_idx && now - last_t < 400000)); then
            G_SEL=$idx
            last_idx=-1
            if ((idx < G_NDIRS)); then
              dir="${G_FILES[idx]}"
              break
            fi
            _g_full "$idx"
            _g_ensure_visible
            _g_redraw
          else
            _g_select "$idx"
            last_idx=$idx
            last_t=$now
          fi
        fi
        ;;
      mclick)
        idx=$(_g_hit)
        if ((idx >= 0)); then
          _g_select "$idx"
          if ((idx < G_NDIRS)); then
            dir="${G_FILES[idx]}"
            break
          fi
          _launch "${G_FILES[idx]}"
          _g_bar "$G_ROWS" "Opened externally"
        fi
        ;;
      o)
        ((G_N)) && {
          while IFS= read -r -d '' f; do _launch "$f"; done < <(_g_targets)
          _g_bar "$G_ROWS" "Opened externally"
        }
        ;;
      y)
        ((G_N)) && {
          if _g_targets | xargs -0 -r printf '%s\n' | _clipboard; then
            _g_bar "$G_ROWS" "Copied path(s) to clipboard"
          else
            _g_bar "$G_ROWS" "No clipboard tool (wl-copy / xclip)"
          fi
        }
        ;;
      x | delete)
        if ((G_N)); then
          local -a tl=()
          while IFS= read -r -d '' f; do tl+=("$f"); done < <(_g_targets)
          _g_bar "$G_ROWS" "Move ${#tl[@]} item(s) to trash? [y/N]"
          _g_readkey
          if [[ "$KEY" == y || "$KEY" == Y ]]; then
            printf '\e[%d;1H\e[0m' "$G_ROWS"
            _trash_and_record "${tl[@]}"
            if ((G_SEL + 1 < G_N)); then
              G_FOCUS="${G_FILES[G_SEL + 1]##*/}"
            elif ((G_SEL > 0)); then
              G_FOCUS="${G_FILES[G_SEL - 1]##*/}"
            fi
            break
          fi
          _g_status
        fi
        ;;
      s)
        case "$G_SORT" in
        name) G_SORT=mtime ;;
        mtime) G_SORT=size ;;
        *) G_SORT=name ;;
        esac
        ((G_N)) && G_FOCUS="${G_FILES[G_SEL]##*/}"
        break
        ;;
      r)
        ((G_N)) && G_FOCUS="${G_FILES[G_SEL]##*/}"
        break
        ;;
      '+' | '=')
        n=$G_NCOLS
        ((n > 1)) && G_NC_FORCE=$((n - 1))
        G_THUMB=()
        _g_relayout
        ;;
      '_')
        n=$G_NCOLS
        ((n < 12)) && G_NC_FORCE=$((n + 1))
        G_THUMB=()
        _g_relayout
        ;;
      f)
        ((G_N)) && GRID_PICK="${G_FILES[G_SEL]}"
        leave=1
        break
        ;;
      '?')
        printf '\e_Ga=d,d=A\e\\\e[0m\e[2J\e[H'
        _help_grid
        printf '\n Press any key...'
        _g_readkey
        _g_redraw
        ;;
      esac
    done

    ((leave)) && break
  done

  _grid_leave
  trap - WINCH
  return 0
}

# ==========================================================================
#  Subcommand dispatch
# ==========================================================================
case "${1:-}" in
-h | --help)
  _usage
  exit 0
  ;;
--preview)
  shift
  _preview "$@"
  exit 0
  ;;
--preview-line)
  shift
  _preview_line "$@"
  exit 0
  ;;
--thumb-any)
  shift
  k=$(_file_kind "$1")
  [[ -z "$k" ]] && k=image
  _make_thumb "$1" "$k" "${FM_THUMB_SIZE:-$GRID_SIZE}" >/dev/null
  exit 0
  ;;
--toggle-gallery)
  g=$(_gflag)
  if [[ -e "$g" ]]; then rm -f -- "$g"; else : >"$g"; fi
  exit 0
  ;;
--gallery-page)
  # $2 = delta, $3 = hovered entry (a directory, or a file -> its directory)
  if [[ -d "$3" ]]; then d=$(readlink -f -- "$3" 2>/dev/null); else d=$(readlink -f -- "$(dirname -- "$3")" 2>/dev/null); fi
  [[ -d "$d" ]] || exit 0
  pf="$(_gflag).page"
  cur=0 pl=""
  if [[ -f "$pf" ]]; then
    IFS=$'\t' read -r pd pn pl <"$pf"
    if [[ "$pd" == "$d" && "$pn" =~ ^[0-9]+$ ]]; then cur=$pn; else pl=""; fi
  fi
  cur=$((cur + $2))
  ((cur < 0)) && cur=0
  printf '%s\t%s\t%s\n' "$d" "$cur" "$pl" >"$pf"
  exit 0
  ;;
--save-port)
  # run by fzf's `start` event: remember how to reach this fm's fzf
  (
    umask 077
    printf '%s\t%s\t%s\n' "${FM_MAIN_PID:-0}" "${FZF_PORT:-}" "${FZF_API_KEY:-}" >"$STATE_DIR/active"
  )
  exit 0
  ;;
--link-open)
  # Called by kitty (open-actions) when a path hyperlink in the preview is
  # Ctrl+Shift+clicked: ask the running fm to go there. No fm -> xdg-open.
  p="${2:-}"
  [[ -e "$p" || -L "$p" ]] || exit 0
  ok=0
  if [[ -r "$STATE_DIR/active" ]]; then
    IFS=$'\t' read -r apid aport akey <"$STATE_DIR/active"
    if [[ -n "$apid" && -n "$aport" ]] && kill -0 "$apid" 2>/dev/null; then
      printf '%s\n' "$p" >"$STATE_DIR/nav.$apid"
      if (
        exec 3<>"/dev/tcp/127.0.0.1/$aport" &&
          printf 'POST / HTTP/1.0\r\nx-api-key: %s\r\nContent-Length: 5\r\n\r\nabort' "$akey" >&3 &&
          read -r -t 2 _ <&3
      ) 2>/dev/null; then
        ok=1
      else
        rm -f -- "$STATE_DIR/nav.$apid"
      fi
    fi
  fi
  if ((! ok)); then
    _have xdg-open && setsid -f xdg-open "$p" >/dev/null 2>&1
  fi
  exit 0
  ;;
--setup-kitty)
  f="${XDG_CONFIG_HOME:-$HOME/.config}/kitty/open-actions.conf"
  if grep -qF -e '--link-open' "$f" 2>/dev/null; then
    echo "fm: already set up in $f"
  else
    mkdir -p -- "$(dirname -- "$f")"
    {
      printf '\n# fm: Ctrl+Shift+click a path in the directory preview to open it in fm\n'
      printf 'protocol file\n'
      # SELF is shell-split by kitty, so quote it; ${FILE_PATH} is expanded by
      # kitty per argument after splitting, so it must stay unquoted.
      printf "action launch --type=background '%s' --link-open \${FILE_PATH}\n" "${SELF//\'/\'\\\'\'}"
    } >>"$f"
    echo "fm: added the rule to $f"
    echo "    Restart kitty, then Ctrl+Shift+click any name in a directory preview."
    echo "    (Needs to come before any other 'protocol file' catch-all rule.)"
  fi
  exit 0
  ;;
--mouse-up)
  : >"$(_gflag).up"
  exit 0
  ;;
--undo-trash)
  _undo_pop_apply
  exit 0
  ;;
--preview-trash)
  shift
  _preview_trash "$1"
  exit 0
  ;;
--help-keys)
  _clear_img
  {
    _help_main
    _help_grid
  } | if _have less; then less -R; else
    cat
    read -rsn1 -p ' Press any key...'
  fi
  exit 0
  ;;
--grid)
  # UI goes to the tty, the pick goes to the real stdout, so
  # `file=$(fm --grid)` works.
  exec 4>&1 >/dev/tty
  trap _grid_leave EXIT
  trap 'exit 130' INT TERM
  if _grid_view "${2:-$PWD}" && [[ -n "$GRID_PICK" ]]; then
    printf '%s\n' "$GRID_PICK" >&4
  fi
  exit 0
  ;;
esac

# ==========================================================================
#  Startup
# ==========================================================================
export FM_MAIN_PID=$$
QSELF=$(printf '%q' "$SELF")
RUN="bash $QSELF"

_have fzf || {
  echo "fm: fzf is required"
  exit 1
}
_have eza || {
  echo "fm: eza is required"
  exit 1
}

start_dir="$PWD"
if [[ -n "${1:-}" ]]; then
  if [[ -d "$1" ]]; then
    start_dir="$1"
  elif [[ -e "$1" ]]; then
    # a file: open its directory with the file focused
    start_dir=$(dirname -- "$1")
    FOCUS_NAME=$(basename -- "$1")
  elif _have zoxide; then
    start_dir=$(zoxide query -- "$@") || {
      echo "fm: no zoxide match for: $*"
      exit 1
    }
  else
    echo "fm: not a directory: $1" >&2
    exit 1
  fi
fi
cd -- "$start_dir" || exit 1
_probe_cell

PREWARM_PID=""
PREWARM_KEY=""

_stop_prewarm() {
  [[ -n "$PREWARM_PID" ]] || return 0
  # children first, then xargs itself (the other order orphans the workers)
  pkill -P "$PREWARM_PID" 2>/dev/null
  kill "$PREWARM_PID" 2>/dev/null
  PREWARM_PID=""
  PREWARM_KEY=""
}

_on_exit() {
  _grid_leave
  _cleanup_kitty
  printf '\e[?1000l\e[?1006l\e[?25h' 2>/dev/null >/dev/tty
  rm -f -- "$(_gflag)" "$(_gflag).page" "$(_gflag).up"
  rm -f -- "$STATE_DIR/nav.$$"
  if [[ -r "$STATE_DIR/active" ]]; then
    IFS=$'\t' read -r apid _ <"$STATE_DIR/active"
    [[ "$apid" == "$$" ]] && rm -f -- "$STATE_DIR/active"
  fi
  _stop_prewarm
}
trap _on_exit EXIT
trap 'exit 130' INT TERM

(find "$THUMB_DIR" "$GALLERY_DIR" -type f -mtime +"$CACHE_DAYS" -delete 2>/dev/null &)

