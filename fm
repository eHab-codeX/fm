# Mouse: double-click selects/opens, right-click goes up (main list) or
# cancels (pickers). right-click only exists in newer fzf, so probe for it.
HAS_RCLICK=0
echo | fzf --filter x --bind 'right-click:abort' >/dev/null 2>&1
(($? != 2)) && HAS_RCLICK=1
PICKER_MOUSE=(--bind 'double-click:accept')
((HAS_RCLICK)) && PICKER_MOUSE+=(--bind 'right-click:abort')
MOUSE_BINDS=(--bind 'double-click:accept')
((HAS_RCLICK)) && MOUSE_BINDS+=(--bind "right-click:execute-silent($RUN --mouse-up)+abort")
# every popup picker (trash, zoxide, bookmarks, destination, git) uses these
PREVIEW_BINDS+=("${PICKER_MOUSE[@]}")

# Clickable paths in directory previews: eza emits OSC 8 hyperlinks, kitty
# turns Ctrl+Shift+click into `fm --link-open PATH` (see --setup-kitty), which
# reaches this fzf through its --listen API (protected by a random key).
LISTEN_OPTS=()
if _in_kitty && [[ "$(eza --help 2>&1)" == *--hyperlink* ]]; then
  echo | fzf --filter x --listen=0 >/dev/null 2>&1
  if (($? != 2)); then
    FZF_API_KEY=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    export FZF_API_KEY FM_HYPERLINK=1
    LISTEN_OPTS=(--listen=0 --bind "start:execute-silent($RUN --save-port)")
  fi
fi

_gb() {
  GB=(--bind "alt-j:execute-silent($RUN --gallery-page 1 $1)+refresh-preview"
    --bind "alt-k:execute-silent($RUN --gallery-page -1 $1)+refresh-preview"
    --bind "alt-n:execute-silent($RUN --gallery-page 1 $1)+refresh-preview"
    --bind "alt-p:execute-silent($RUN --gallery-page -1 $1)+refresh-preview")
}

_edit() { _open_at "$1"; }

_prewarm() {
  # same directory + hidden setting and still running: leave it alone
  local key="$PWD|$SHOW_HIDDEN"
  if [[ -n "$PREWARM_PID" && "$PREWARM_KEY" == "$key" ]] && kill -0 "$PREWARM_PID" 2>/dev/null; then
    return 0
  fi
  _stop_prewarm
  PREWARM_KEY="$key"
  local hid=()
  [[ "$SHOW_HIDDEN" == "0" ]] && hid=(-not -name '.*')
  local workers
  workers=$(_workers)
  xargs -0 -r -n1 -P"$workers" bash "$SELF" --thumb-any \
    < <(find . -maxdepth 1 -type f "${hid[@]}" "${GALLERY_FIND[@]}" -print0 2>/dev/null | _head0 400) \
    >/dev/null 2>&1 &
  PREWARM_PID=$!
}

# Output: "rawname<TAB>eza-rendered name". One batched stat, one awk pass.
_fm_list() {
  local -a names=()
  local fd_flags=() find_flags=()
  [[ "$SHOW_HIDDEN" == "1" ]] && fd_flags+=(--hidden)
  # Flat listing shows everything (like the find fallback); the recursive
  # view keeps .gitignore so node_modules & co. don't flood it.
  [[ "$MAX_DEPTH" == "1" ]] && fd_flags+=(--no-ignore)
  [[ "$SHOW_HIDDEN" == "0" ]] && find_flags=(-not -path '*/.*')

  if _have fd; then
    mapfile -t names < <(fd "${fd_flags[@]}" --follow --exclude .git \
      --max-depth "$MAX_DEPTH" . 2>/dev/null |
      sed -e 's|^\./||' -e 's|/$||')
  else
    mapfile -t names < <(find . -mindepth 1 -maxdepth "$MAX_DEPTH" \
      -not -name .git -not -path '*/.git/*' "${find_flags[@]}" -printf '%P\n' 2>/dev/null)
  fi

  local sorted="" nl=$'\n'
  if ((${#names[@]})); then
    # stat -L first so symlinks-to-dirs sort as dirs; plain stat second to
    # pick up broken symlinks (awk keeps the first record per name).
    local meta keys
    meta=$({
      printf '%s\0' "${names[@]}" | xargs -0 -r stat -L -c $'%n\t%F\t%s\t%Y' -- 2>/dev/null
      printf '%s\0' "${names[@]}" | xargs -0 -r stat -c $'%n\t%F\t%s\t%Y' -- 2>/dev/null
    })
    # No %020d padding: mawk clamps %d at 2^31, which mangled big sizes.
    keys=$(awk -F'\t' -v mode="$SORT_MODE" '
      seen[$1]++ { next }
      {
        d = ($2 == "directory") ? 1 : 2
        name = $1; lower = tolower(name)
        if (mode == "name") {
          printf "%d\t%s\t\t%s\n", d, lower, name
        } else if (mode == "size") {
          printf "%d\t%s\t%s\t%s\n", d, $3, lower, name
        } else if (mode == "mtime") {
          printf "%d\t%s\t%s\t%s\n", d, $4, lower, name
        } else {
          ext = name; sub(/^.*\./, "", ext); if (ext == name) ext = ""
          printf "%d\t%s\t%s\t%s\n", d, tolower(ext), lower, name
        }
      }' <<<"$meta")

    case "$SORT_MODE" in
    name) sorted=$(sort -t$'\t' -k1,1n -k2,2V <<<"$keys" | cut -f4-) ;;
    size) sorted=$(sort -t$'\t' -k1,1n -k2,2nr -k3,3V <<<"$keys" | cut -f4-) ;;
    mtime) sorted=$(sort -t$'\t' -k1,1n -k2,2nr -k3,3V <<<"$keys" | cut -f4-) ;;
    ext) sorted=$(sort -t$'\t' -k1,1n -k2,2V -k3,3V <<<"$keys" | cut -f4-) ;;
    esac
  fi

  # ".." must exist even in an empty directory, otherwise entering one
  # would dump you out of fm.
  [[ "$PWD" != "/" ]] && sorted="..${sorted:+$nl$sorted}"
  [[ -z "$sorted" ]] && return 0

  local rendered
  rendered=$(printf '%s\n' "$sorted" | xargs -d '\n' eza -1 -d --sort=none \
    --icons=always --color=always --no-quotes -- 2>/dev/null)

  if [[ $(wc -l <<<"$sorted") -eq $(wc -l <<<"$rendered") ]]; then
    paste -d '\t' <(printf '%s\n' "$sorted") <(printf '%s\n' "$rendered")
  else
    while IFS= read -r name; do printf '%s\t%s\n' "$name" "$name"; done <<<"$sorted"
  fi
}

_open_file() {
  local f="$1" mime kind
  kind=$(_file_kind "$f")
  case "$kind" in
  image | video)
    _launch "$f"
    return
    ;;
  esac
  mime=$(file --mime-type -b -- "$f" 2>/dev/null)
  case "$mime" in
  audio/* | application/pdf | application/epub+zip | \
    application/vnd.openxmlformats-officedocument.* | \
    application/vnd.oasis.opendocument.* | \
    application/msword | application/vnd.ms-* | \
    application/x-iso9660-appimage | application/x-executable | \
    application/x-pie-executable | application/x-sharedlib | application/zip | \
    application/x-tar | application/x-7z-compressed | application/x-rar | \
    application/gzip | application/x-bzip2 | application/x-xz | \
    application/x-zstd)
    _launch "$f"
    ;;
  *)
    _edit "$f"
    ;;
  esac
}

_pick_dest() {
  local dest
  _gb '{}'
  dest=$(
    {
      echo "$PWD"
      _have zoxide && zoxide query --list 2>/dev/null
      echo "$HOME"
      echo "/tmp"
      if _have fd; then
        fd --type d --hidden --exclude .git --exclude node_modules --exclude .cache \
          --max-depth 4 . "$HOME" 2>/dev/null | sed 's|/$||'
      else
        find "$HOME" -maxdepth 4 -type d \
          -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/.cache/*' 2>/dev/null
      fi
    } | awk '!seen[$0]++' |
      FZF_DEFAULT_OPTS='' fzf \
        --height 60% --layout reverse --border \
        --prompt 'Destination > ' \
        --preview "$RUN --preview {}" --preview-window 'right:60%:wrap' \
        "${PREVIEW_BINDS[@]}" \
        "${GB[@]}" \
        --header 'Enter: choose destination  C-v/C-u: scroll preview  Esc: cancel'
  )
  _cleanup_kitty
  [[ -n "$dest" ]] && printf '%s\n' "$dest"
}

_bm_remove() {
  [[ -f "$BOOKMARKS_FILE" ]] || return 0
  awk -F'|' -v n="$1" '$1 != n' "$BOOKMARKS_FILE" >"$BOOKMARKS_FILE.tmp" &&
    mv -- "$BOOKMARKS_FILE.tmp" "$BOOKMARKS_FILE"
}

_have zoxide && zoxide add -- "$PWD"

# ==========================================================================
#  Main loop
# ==========================================================================
while true; do
  entries=$(_fm_list)

  if [[ -z "$entries" ]]; then
    echo "(empty directory)"
    exit 0
  fi

  _prewarm

  fzf_extra=()
  if [[ -n "$FOCUS_NAME" ]]; then
    fidx=$(FN="$FOCUS_NAME" awk -F'\t' '$1==ENVIRON["FN"]{print NR; exit}' <<<"$entries")
    [[ -n "$fidx" ]] && fzf_extra=(--bind "start:pos($fidx)")
    FOCUS_NAME=""
  fi

  _gb '{1}'
  selection=$(
    printf '%s\n' "$entries" | FZF_DEFAULT_OPTS='' fzf \
      --height 70% \
      --layout reverse \
      --border \
      --info inline \
      --ansi \
      --delimiter=$'\t' \
      --with-nth=2 \
      --prompt "$(_tilde "$PWD") > " \
      --preview "$RUN --preview {1}" \
      --preview-window 'right:60%:wrap' \
      "${PREVIEW_BINDS[@]}" \
      "${GB[@]}" \
      "${MOUSE_BINDS[@]}" \
      "${LISTEN_OPTS[@]}" \
      --bind "ctrl-t:execute-silent($RUN --toggle-gallery)+refresh-preview" \
      --bind "f1:execute($RUN --help-keys)" \
      --bind "alt-h:execute($RUN --help-keys)" \
      "${fzf_extra[@]}" \
      --expect='ctrl-d,alt-d,ctrl-z,alt-t,ctrl-y,ctrl-o,ctrl-n,ctrl-e,ctrl-k,ctrl-p,ctrl-b,ctrl-r,ctrl-h,alt-.,ctrl-g,alt-z,alt-g,ctrl-f,alt-i,ctrl-l,ctrl-s,alt-m,ctrl-w' \
      --multi \
      --header "$(_fm_header)"
  )
  _cleanup_kitty

  navf="$STATE_DIR/nav.$$"
  if [[ -s "$navf" ]]; then # Ctrl+Shift+click on a path in the preview
    IFS= read -r navp <"$navf"
    rm -f -- "$navf"
    if [[ -d "$navp" ]]; then
      _cd "$navp" || break
    elif [[ -e "$navp" || -L "$navp" ]]; then
      _cd "$(dirname -- "$navp")" || break
      FOCUS_NAME=$(basename -- "$navp")
      _open_file "$navp"
    fi
    continue
  fi

  upflag="$(_gflag).up"
  if [[ -e "$upflag" ]]; then # right-click: go to the parent directory
    rm -f -- "$upflag"
    if [[ "$PWD" != "/" ]]; then
      FOCUS_NAME="${PWD##*/}"
      _cd .. || break
    fi
    continue
  fi

  [[ -z "$selection" ]] && break

  key=$(head -1 <<<"$selection")

  all=()
  sel=()
  raw=$(tail -n +2 <<<"$selection" | cut -f1)
  [[ -n "$raw" ]] && mapfile -t all <<<"$raw"
  for f in "${all[@]}"; do [[ "$f" != ".." ]] && sel+=("$f"); done

  case "$key" in
  alt-g)
    gdir="$PWD"
    ((${#sel[@]})) && [[ -d "${sel[0]}" ]] && gdir="$PWD/${sel[0]}"
    _grid_view "$gdir"
    if [[ -n "$GRID_PICK" ]]; then
      _cd "$(dirname -- "$GRID_PICK")" && FOCUS_NAME=$(basename -- "$GRID_PICK")
    fi
    continue
    ;;
  alt-z)
    _have zoxide || {
      _pause "zoxide is not installed"
      continue
    }
    _gb '{}'
    zt=$(zoxide query --list 2>/dev/null | FZF_DEFAULT_OPTS='' fzf \
      --height 60% --layout reverse --border --no-sort \
      --prompt 'zoxide > ' \
      --preview "$RUN --preview {}" --preview-window 'right:60%:wrap' \
      "${PREVIEW_BINDS[@]}" \
      "${GB[@]}" \
      --header 'Enter: jump  A-j/A-k: gallery page  Esc: cancel')
    _cleanup_kitty
    [[ -d "$zt" ]] && _cd "$zt"
    continue
    ;;
  ctrl-d | alt-d)
    ((${#sel[@]})) || continue
    _trash_and_record "${sel[@]}"
    continue
    ;;
  ctrl-z)
    _undo_pop_apply
    continue
    ;;
  alt-t)
    _trash_browser
    continue
    ;;
  ctrl-y)
    ((${#sel[@]})) || continue
    for f in "${sel[@]}"; do printf '%s\n' "$PWD/$f"; done | _clipboard ||
      _pause "No clipboard tool found (wl-copy / xclip)"
    continue
    ;;
  ctrl-o)
    for f in "${sel[@]}"; do _launch "$f"; done
    continue
    ;;
  ctrl-n)
    read -r -p "Name (end with / for dir): " name
    [[ -z "$name" ]] && continue
    if [[ "$name" == */ ]]; then
      mkdir -p -- "${name%/}"
    else
      mkdir -p -- "$(dirname -- "$name")" && touch -- "$name"
    fi || _pause "Failed to create: $name"
    continue
    ;;
  ctrl-e)
    ((${#sel[@]} == 1)) || {
      _pause "Select exactly one item to rename."
      continue
    }
    old="${sel[0]}"
    read -r -e -i "$old" -p "Rename to: " newname
    [[ -z "$newname" || "$newname" == "$old" ]] && continue
    if [[ -e "$newname" ]]; then
      read -r -p "'$newname' exists. Overwrite? [y/N] " ans
      [[ "$ans" =~ ^[Yy]$ ]] || continue
    fi
    mv -T -- "$old" "$newname" || _pause "Rename failed"
    continue
    ;;
  alt-m | ctrl-w)
    ((${#sel[@]})) || continue
    _bulk_rename "${sel[@]}"
    continue
    ;;
  ctrl-k)
    ((${#sel[@]})) || continue
    dest=$(_pick_dest)
    [[ -z "$dest" ]] && continue
    for f in "${sel[@]}"; do mv -i -- "$f" "$dest/" || _pause "Move failed: $f"; done
    continue
    ;;
  ctrl-p)
    ((${#sel[@]})) || continue
    dest=$(_pick_dest)
    [[ -z "$dest" ]] && continue
    for f in "${sel[@]}"; do cp -ri -- "$f" "$dest/" || _pause "Copy failed: $f"; done
    continue
    ;;
  ctrl-l)
    ((${#sel[@]})) || continue
    read -r -p "Symlink name [default: same name]: " linkname
    for f in "${sel[@]}"; do
      target=$(readlink -f -- "$f")
      lname="${linkname:-$(basename -- "$f")}"
      if [[ -e "$lname" || -L "$lname" ]]; then
        _pause "Exists: $lname"
        continue
      fi
      ln -s -- "$target" "$lname" || _pause "Failed: $lname"
    done
    continue
    ;;
  alt-i)
    if ((${#sel[@]} == 1)); then
      f="${sel[0]}"
      if _have exiftool && file --mime-type -b -- "$f" | grep -q '^image/'; then
        exiftool -- "$f" | less -R
      else
        {
          stat -- "$f"
          echo
          file -- "$f"
          echo
          if [[ -f "$f" ]] && file --mime-encoding -b -- "$f" | grep -qv binary; then
            echo "--- first 40 lines ---"
            head -n 40 -- "$f"
          fi
        } | less -R
      fi
      _cleanup_kitty
    fi
    continue
    ;;
  ctrl-f)
    if ((${#sel[@]})); then
      _search_content "${sel[@]}"
    else
      _search_content
    fi
    continue
    ;;
  ctrl-s)
    case "$SORT_MODE" in
    name) SORT_MODE=size ;;
    size) SORT_MODE=mtime ;;
    mtime) SORT_MODE=ext ;;
    ext) SORT_MODE=name ;;
    esac
    continue
    ;;
  ctrl-b)
    touch "$BOOKMARKS_FILE"
    _gb '{2}'
    out=$(
      {
        printf '%s|%s\n' "$ADD_LABEL" "$PWD"
        cat "$BOOKMARKS_FILE"
      } |
        FZF_DEFAULT_OPTS='' fzf \
          --height 60% --layout reverse --border \
          --prompt 'Bookmark > ' \
          --delimiter='|' \
          --expect=ctrl-x \
          --preview "$RUN --preview {2}" --preview-window 'right:60%:wrap' \
          "${PREVIEW_BINDS[@]}" \
          "${GB[@]}" \
          --header 'Enter: jump or add  Ctrl-X: delete  Esc: cancel'
    )
    _cleanup_kitty
    [[ -z "$out" ]] && continue
    bkey=$(sed -n 1p <<<"$out")
    choice=$(sed -n 2p <<<"$out")
    [[ -z "$choice" ]] && continue
    bname="${choice%%|*}"
    target="${choice#*|}"
    if [[ "$bkey" == "ctrl-x" ]]; then
      [[ "$bname" == "$ADD_LABEL" ]] || _bm_remove "$bname"
    elif [[ "$bname" == "$ADD_LABEL" ]]; then
      read -r -e -i "$(basename "$PWD")" -p "Bookmark name: " bname
      if [[ -z "$bname" || "$bname" == *'|'* ]]; then
        _pause "Invalid bookmark name (empty or contains '|')"
        continue
      fi
      _bm_remove "$bname"
      printf '%s|%s\n' "$bname" "$PWD" >>"$BOOKMARKS_FILE"
    else
      _cd "$target" 2>/dev/null || _pause "Not a directory: $target"
    fi
    continue
    ;;
  ctrl-r)
    [[ "$MAX_DEPTH" == "1" ]] && MAX_DEPTH=5 || MAX_DEPTH=1
    continue
    ;;
  ctrl-h | alt-.)
    [[ "$SHOW_HIDDEN" == "1" ]] && SHOW_HIDDEN=0 || SHOW_HIDDEN=1
    continue
    ;;
  ctrl-g)
    top=$(git rev-parse --show-toplevel 2>/dev/null) ||
      {
        _pause "Not a git repository."
        continue
      }
    qtop=$(printf '%q' "$top")
    git_file=$(
      {
        git -C "$top" -c core.quotePath=false diff --name-only
        git -C "$top" -c core.quotePath=false diff --cached --name-only
        git -C "$top" -c core.quotePath=false ls-files --others --exclude-standard
      } | sort -u |
        while IFS= read -r p; do [[ -e "$top/$p" ]] && printf '%s\n' "$p"; done |
        FZF_DEFAULT_OPTS='' fzf \
          --height 70% --layout reverse --border \
          --preview "cd $qtop && $RUN --preview {}" --preview-window 'right:60%:wrap' \
          "${PREVIEW_BINDS[@]}" \
          --header 'Git modified/untracked files  C-v/C-u: scroll preview'
    )
    _cleanup_kitty
    [[ -n "$git_file" ]] && _open_file "$top/$git_file"
    continue
    ;;
  esac

  # -------- Enter --------
  ((${#all[@]})) || continue

  if ((${#all[@]} == 1)) && [[ "${all[0]}" == ".." ]]; then
    FOCUS_NAME="${PWD##*/}" # land on the directory we just left
    _cd .. || break
  elif ((${#all[@]} == 1)) && [[ -d "${all[0]}" ]]; then
    _cd "${all[0]}" || break
  else
    for f in "${sel[@]}"; do
      [[ -d "$f" ]] && continue
      _open_file "$f"
    done
  fi
done
